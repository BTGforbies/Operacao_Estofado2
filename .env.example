# Required. Keep stable between deployments; generate with Python secrets.token_urlsafe(48).
SECRET_KEY=
APP_ENV=development

# Required only when creating the first administrator in an empty database.
ADMIN_PASSWORD=

# Google OAuth 2.0 Web application credentials (Google Cloud Console).
# Authorized redirect URI: https://YOUR_DOMAIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Use a managed PostgreSQL database in production. If unset, local SQLite is used.
DATABASE_URL=
# Optional local SQLite location and private upload directory.
APP_DB=estofados.db
UPLOAD_DIR=uploads
